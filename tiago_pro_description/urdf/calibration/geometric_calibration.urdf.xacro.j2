<?xml version="1.0"?>
<!--

  Geometric calibration deltas (full_params, per-joint 6-DOF corrections).
  Rendered from /etc/calibration/master_calibration.yaml via launch_pal.calibration_utils,
  same mechanism as calibration_offset.urdf.xacro.j2. Each property defaults to 0.0 when
  absent, so an uncalibrated robot is unaffected.

  Consumed by:
    - tiago_pro.urdf.xacro (arm_right_1 / arm_left_1 origin, applied post-mirror)
    - arm.properties.xacro / spherical-wrist.properties.xacro (origin_joint_2..7 macros)
    - pal_atc gripper.urdf.xacro (tool_mount_joint origin)

-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

