<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!--arg name="laser_model"  default="sick-571"/-->
    <arg name="is_simulation"     default="false"/>

    <!-- Joint state controllers -->
    <include file="$(find tiago_pro_controller_configuration)/launch/joint_state_controller.launch"/>
    <!-- Default controllers -->
    <include file="$(find tiago_pro_controller_configuration)/launch/default_controllers.launch"/>
   
    <!-- Impedance controllers loaded as stopped -->
    <include file="$(find tiago_pro_controller_configuration)/launch/impedance_controllers.launch"/>

    <rosparam command="load" file="$(find pal_pro_gripper_controller_configuration)/config/joint_trajectory_controllers.yaml" />
    <include file="$(find pal_pro_gripper_controller_configuration)/launch/gripper_controller.launch">
      <arg name="is_simulation" value="$(arg is_simulation)"/>
      <arg name="side" value="right"/>
    </include>

    <include file="$(find pal_pro_gripper_controller_configuration)/launch/gripper_controller.launch">
      <arg name="is_simulation" value="$(arg is_simulation)"/>
      <arg name="side" value="left"/>
    </include>

    <!-- Load gravity compensation controller parameters -->
    <include file="$(find tiago_pro_controller_configuration)/launch/gravity_compensation_controller.launch"/>

    <!-- Load gravity compensation controller parameters per arm -->
    <include file="$(find tiago_pro_controller_configuration)/launch/gravity_compensation_controller_arm.launch">
      <arg name="side" value="left"/>
    </include>

    <include file="$(find tiago_pro_controller_configuration)/launch/gravity_compensation_controller_arm.launch">
      <arg name="side" value="right"/>
    </include>

    <!-- Motion planning -->
    <include file="$(find tiago_pro_moveit_config)/launch/move_group.launch" />

</launch>

