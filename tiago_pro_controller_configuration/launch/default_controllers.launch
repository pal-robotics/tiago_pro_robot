<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <arg name="is_simulation"     default="false"/>

  <rosparam command="load" file="$(find tiago_pro_controller_configuration)/config/joint_trajectory_controllers.yaml" />
  <rosparam command="load" file="$(find tiago_pro_controller_configuration)/config/mobile_base_controller.yaml" />
  <rosparam command="load" file="$(find tiago_pro_controller_configuration)/config/current_limit_controllers.yaml" unless="$(eval is_simulation)"/>

  <arg name="controller_list"
       value="torso_controller
              mobile_base_controller
              wheels_current_limit_controller
              head_controller
              "
       unless="$(eval is_simulation)"/>
	  
  <!-- The following controllers 'arm_left_controller' and 'arm_right_controller' 
	 already launched in the tiago2_torso_up node-->

  <arg name="controller_list"
       value="
              arm_left_controller
              arm_right_controller
              torso_controller
              mobile_base_controller
              head_controller
              "
       if="$(eval is_simulation)"/>

  <node name="default_controllers_spawner"
        pkg="controller_manager" type="spawner" output="screen"
        args="--timeout 300 $(arg controller_list)" />

  <!-- Point head action -->
  <group ns="head_controller">
    <node name="point_head_action" pkg="head_action" type="head_action" output="screen">
      <rosparam>
        pan_link:  head_1_link
        tilt_link: head_2_link
        success_angle_threshold: 0.01
      </rosparam>
    </node>
  </group>

</launch>
