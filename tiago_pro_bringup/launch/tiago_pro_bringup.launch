<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="robot_namespace" default=""/>

  <!-- Just load the actuator_pid_command_controller parameters, and then the loading and switching is taken care by tiago_pro_torso_up_startup node-->
  <rosparam command="load" file="$(find tiago_pro_bringup)/config/tiago_pro_pids.yaml" ns="actuator_pid_command_controller"/>

  <!-- Load default controllers -->
  <include file="$(find tiago_pro_controller_configuration)/launch/tiago_pro_controllers.launch"/>

  <!-- Robot state publisher -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" type="double" value="50.0"/>
    <param name="tf_prefix" type="string" value="$(arg robot_namespace)"/>
    <param name="use_tf_static" type="bool" value="true"/>
  </node>

  <!-- Robot pose publisher -->
  <node pkg="robot_pose" type="robot_pose_node" name="robot_pose_publisher" output="screen"/> 

  <!-- Torso up and start the controllers -->
  <!-- Torso up > Load the actuators PID > Start left and right arm position controllers -->
  <node pkg="get_out_of_collision" type="tiago2_torso_up_startup" name="tiago2_torso_up_startup" output="screen"/>

  <!-- TF lookup -->
  <node pkg="tf_lookup" type="tf_lookup" name="tf_lookup" output="screen"/>

  <!-- Twist mux -->
  <include file="$(find tiago_pro_bringup)/launch/twist_mux.launch"/>

  <!-- Launch play motion -->
  <include file="$(find tiago_pro_bringup)/launch/play_motion.launch"/>

    <!-- Joystick controller -->
  <include file="$(find tiago_pro_bringup)/launch/joystick_teleop.launch"/>



</launch>
