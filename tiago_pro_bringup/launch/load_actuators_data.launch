<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <arg name="fingerprint_pkg"/>
  <arg name="namespace" default="actuators_data"/>

  <!-- Load actuator data for each actuator -->
  <include file="$(find tiago_pro_bringup)/launch/load_actuator_data.launch">
    <arg name="motor_name" value="arm_left_1_motor"/>
    <arg name="fingerprint_pkg" value="$(arg fingerprint_pkg)"/>
    <arg name="namespace" value="$(arg namespace)"/>
  </include>

  <include file="$(find tiago_pro_bringup)/launch/load_actuator_data.launch">
