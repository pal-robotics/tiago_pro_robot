  <include file="$(find tiago_pro_bringup)/launch/load_actuator_data.launch">
    <arg name="motor_name" value="arm_right_3_motor"/>
    <arg name="fingerprint_pkg" value="$(arg fingerprint_pkg)"/>
    <arg name="namespace" value="$(arg namespace)"/>
  </include>

  <include file="$(find tiago_pro_bringup)/launch/load_actuator_data.launch">
    <arg name="motor_name" value="arm_right_4_motor"/>
    <arg name="fingerprint_pkg" value="$(arg fingerprint_pkg)"/>
    <arg name="namespace" value="$(arg namespace)"/>
  </include>

  <include file="$(find tiago_pro_bringup)/launch/load_actuator_data.launch">
    <arg name="motor_name" value="arm_right_5_motor"/>
    <arg name="fingerprint_pkg" value="$(arg fingerprint_pkg)"/>
    <arg name="namespace" value="$(arg namespace)"/>
  </include>

  <include file="$(find tiago_pro_bringup)/launch/load_actuator_data.launch">
